# Supabase público usado pelas demais telas do frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Alternativamente, podem ser usados os nomes padrão do Vite:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Pedidos: URL pública do Worker Cloudflare, sem /api/pedidos no final.
# Exemplo: https://santa-print-pedidos.seu-subdominio.workers.dev
VITE_PEDIDOS_API_URL=https://santa-print-pedidos.example.workers.dev

# As credenciais usadas pelo Worker (SUPABASE_URL e SUPABASE_API_KEY)
# devem ser cadastradas como Secrets na Cloudflare e nunca como VITE_*.
