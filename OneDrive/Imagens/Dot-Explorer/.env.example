# Supabase público usado pelo frontend
# Estes são os nomes já aceitos no deploy da Vercel.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Alternativamente, podem ser usados os nomes padrão do Vite:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Servidor / Vercel Functions
# Necessário para endpoints que acessam views privadas, como /api/pedidos.
# Configure apenas nas Environment Variables da Vercel. Nunca use prefixo VITE_.
SUPABASE_SECRET_KEY=your-server-secret-key

# Nunca exponha SUPABASE_SECRET_KEY ou service_role no frontend.
