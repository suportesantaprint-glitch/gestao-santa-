# Supabase público usado pelas demais telas do frontend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Alternativamente, podem ser usados os nomes padrão do Vite:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Pedidos: URL pública do Worker Cloudflare, sem /api/pedidos no final.
# O frontend já usa esta URL como fallback de produção.
VITE_PEDIDOS_API_URL=https://gestao-santa.suporte-santaprint.workers.dev

# Credenciais do Worker:
# SUPABASE_URL deve ser configurada no Dashboard da Cloudflare.
# SUPABASE_SECRET_KEY deve ser cadastrada como Secret e nunca como VITE_*.
